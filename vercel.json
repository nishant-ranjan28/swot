{
  "outputDirectory": "build",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "swot-analyse.vercel.app" }],
      "destination": "https://swot.iamnishant.in/:path*",
      "permanent": true
    }
  ]
}

{
  "outputDirectory": "build",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "swot-analyse.vercel.app"
        }
      ],
      "destination": "https://swot.iamnishant.in/$1",
      "permanent": true
    }
  ]
}

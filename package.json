{
  "name": "swot-analysis",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.18.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lightweight-charts": "^5.2.0",
    "papaparse": "^5.5.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.14.2",
    "uplot": "^1.6.32"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint src --ext .js,.jsx",
    "format": "prettier --write ."
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "browser": true,
      "es2022": true,
      "node": true
    },
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module",
      "ecmaFeatures": {
        "jsx": true
      }
    },
    "settings": {
      "react": {
        "version": "detect"
      }
    },
    "extends": [
      "eslint:recommended",
      "plugin:react/recommended",
      "plugin:react/jsx-runtime",
      "plugin:react-hooks/recommended",
      "prettier"
    ],
    "rules": {
      "react/prop-types": "off",
      "no-unused-vars": "warn",
      "react-hooks/set-state-in-effect": "warn",
      "react/no-unescaped-entities": "warn",
      "no-empty": "warn",
      "no-irregular-whitespace": "warn"
    },
    "overrides": [
      {
        "files": [
          "**/*.test.{js,jsx}"
        ],
        "globals": {
          "vi": "readonly",
          "test": "readonly",
          "expect": "readonly",
          "describe": "readonly",
          "it": "readonly"
        }
      }
    ]
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "autoprefixer": "^10.5.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.0",
    "mocha": "^11.7.5",
    "postcss": "^8.5.14",
    "postcss-import": "^16.1.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
